{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "oness-one-preview",
  "main": "worker.js",
  "compatibility_date": "2026-10-09",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*.htm",
      "/*.html",
      "/"
    ]
  }
}
